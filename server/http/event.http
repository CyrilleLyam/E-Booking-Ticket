@server_HostAddress = http://localhost:5142
@token = YOUR_ACCESS_TOKEN_HERE

GET {{server_HostAddress}}/api/events?page=1&page_size=10
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{server_HostAddress}}/api/events?name=Festival&start_time=2026-10-01T00:00:00Z&page=1&page_size=10
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{server_HostAddress}}/api/events/1
Authorization: Bearer {{token}}
Accept: application/json

###

POST {{server_HostAddress}}/api/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rock Festival 2026",
  "start_time": "2026-10-01T18:00:00Z",
  "venue_capacity": 500
}

###

PUT {{server_HostAddress}}/api/events/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rock Festival 2026 (Updated)",
  "venue_capacity": 600
}

###

DELETE {{server_HostAddress}}/api/events/1
Authorization: Bearer {{token}}
