@server_HostAddress = http://localhost:5142
@token = YOUR_ACCESS_TOKEN_HERE

GET {{server_HostAddress}}/api/events?page=1&page_size=10
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{server_HostAddress}}/api/events?name=Festival&start_date=2026-10-01T00:00:00Z&end_date=2026-10-31T23:59:59Z&page=1&page_size=10
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{server_HostAddress}}/api/events/1
Authorization: Bearer {{token}}
Accept: application/json

###

POST {{server_HostAddress}}/api/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rock Festival 2026",
  "description": "Annual open air music festival",
  "start_date": "2026-10-01T18:00:00Z",
  "end_date": "2026-10-01T23:00:00Z",
  "location": "Olympic Stadium",
  "total_seats": 500
}

###

PUT {{server_HostAddress}}/api/events/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rock Festival 2026 (Updated)",
  "total_seats": 600
}

###

DELETE {{server_HostAddress}}/api/events/1
Authorization: Bearer {{token}}
